<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pleos Vehicle SDK 읽기 권한: 2열 도어·좌석 착석·벨트·기어 -->
    <uses-permission android:name="pleos.car.permission.CAR_DOORS" />
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />
    <uses-permission android:name="pleos.car.permission.CAR_SAFETY" />
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <!-- 시연용: 에뮬레이터에서 2열 뒷문 열고 닫기(SDK 제어 API) -->
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_DOORS" />
    <!-- Pleos NaviHelper: 학원 목적지 경로 요청·주행 정보(도착 예정) -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@android:drawable/ic_menu_myplaces"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <meta-data android:name="distractionOptimized" android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <meta-data android:name="distractionOptimized" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
